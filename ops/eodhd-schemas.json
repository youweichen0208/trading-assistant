  "capture_realtime_ws": {
    "properties": {
      "feed": {
        "type": "string",
        "description": "One of {'us_trades','us_quotes','us_candles','us_status',\n'eu_trades','eu_quotes','eu_candles','eu_status','forex','crypto'}."
      },
      "symbols": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        ],
        "description": "Single or comma-separated symbols, or a list.\nUS equities use plain tickers ('AAPL'); European equities use\nTICKER.EXCHANGE ('GSK.LSE'). For a European dual-class ticker the\nun-hyphenated alias is accepted too, and the reply always reports the\ncanonical hyphenated form in 's'.\nReturns:"
      },
      "duration_seconds": {
        "default": 5,
        "type": "integer"
      },
      "api_token": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "max_messages": {
        "anyOf": [
          {
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "ping_interval": {
        "default": 20.0,
        "type": "number"
      },
      "ping_timeout": {
        "default": 20.0,
        "type": "number"
      },
      "connect_timeout": {
        "default": 15.0,
        "type": "number"
      },
      "max_data_bytes": {
        "default": 52428800,
        "type": "integer"
      }
    },
    "required": [
      "feed",
      "symbols"
    ],
    "type": "object",
    "additionalProperties": false
  },
